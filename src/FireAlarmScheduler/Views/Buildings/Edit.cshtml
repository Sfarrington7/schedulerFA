@* Rename a building, change its notes, or remove it from the job. *@
@model BuildingFormModel
@{
    ViewData["Title"] = "Edit building";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Jobs" asp-action="Index">Jobs</a></li>
        <li class="breadcrumb-item"><a asp-controller="Jobs" asp-action="Details" asp-route-id="@Model.JobId">@Model.JobName</a></li>
        <li class="breadcrumb-item active" aria-current="page">Edit building</li>
    </ol>
</nav>

<h1 class="h3">Edit building</h1>
<div style="max-width: 40rem">
    <form asp-action="Edit" asp-route-jobId="@Model.JobId" asp-route-buildingId="@Model.BuildingId" method="post" class="card card-body mb-3">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Notes" class="text-danger small"></span>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Save</button>
            <a class="btn btn-outline-secondary" asp-controller="Jobs" asp-action="Details" asp-route-id="@Model.JobId">Cancel</a>
        </div>
    </form>
    <form asp-action="Delete" asp-route-jobId="@Model.JobId" asp-route-buildingId="@Model.BuildingId" method="post"
          onsubmit="return confirm('Remove this building from the job?');">
        <button type="submit" class="btn btn-outline-danger">Remove building</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
