@* Technician job page: job facts, the link to the job's files, and the building checklist split into "To do" and
   "Completed". Ticking a building moves it between the two lists (wwwroot/js/building-checklist.js). *@
@model TechnicianJobViewModel
@{
    ViewData["Title"] = Model.Job.Summary.Name;
    var todo = Model.ItemsWhere(complete: false);
    var done = Model.ItemsWhere(complete: true);
}

<a class="btn btn-sm btn-outline-secondary mb-3" asp-action="Index" asp-route-technicianId="@Model.Technician.Id">&larr; My schedule</a>

<h1 class="h4">@Model.Job.Summary.Name</h1>
<p class="small text-body-secondary">Viewing as @Model.Technician.FullName</p>

<div class="card card-body mb-3">
    <partial name="_JobInfo" model="Model.Job" />
</div>

<section class="building-checklist" id="checklist" data-checklist aria-labelledby="checklist-title">
    <h2 class="h5" id="checklist-title">Buildings</h2>
    @if (Model.Job.Buildings.Count == 0)
    {
        <p class="text-body-secondary">No buildings have been added to this job yet.</p>
    }
    else
    {
        <partial name="_BuildingProgress" model="Model.Job" />
        @if (!Model.CanCheckOffBuildings)
        {
            <p class="small text-body-secondary mt-2 mb-0">Only @Model.Technician.FullName can check buildings off this list.</p>
        }
        <div class="alert alert-danger py-2 small mt-3 mb-0" role="alert" data-checklist-error hidden></div>

        <h3 class="checklist-heading">To do <span class="badge text-bg-secondary" data-count="todo">@todo.Count</span></h3>
        <ul class="list-group checklist-list" data-list="todo" aria-label="Buildings to do">
            @foreach (var item in todo)
            {
                <partial name="_ChecklistItem" model="item" />
            }
        </ul>
        <p class="checklist-empty" data-empty="todo" hidden="@(todo.Count > 0)">Every building is complete.</p>

        <h3 class="checklist-heading">Completed <span class="badge text-bg-success" data-count="done">@done.Count</span></h3>
        <ul class="list-group checklist-list" data-list="done" aria-label="Completed buildings">
            @foreach (var item in done)
            {
                <partial name="_ChecklistItem" model="item" />
            }
        </ul>
        <p class="checklist-empty" data-empty="done" hidden="@(done.Count > 0)">Nothing checked off yet. Tick each building as you finish it.</p>
    }
</section>

@section Scripts {
    <script src="~/js/building-checklist.js" asp-append-version="true"></script>
}
