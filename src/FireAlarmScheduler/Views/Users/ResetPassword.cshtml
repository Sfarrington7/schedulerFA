@* Set a new password for another account (for example, when someone forgets theirs). *@
@model ResetPasswordFormModel
@{
    ViewData["Title"] = "Reset password";
}

<h1 class="h3">Reset password for @Model.DisplayName</h1>
<form asp-action="ResetPassword" asp-route-id="@Model.Id" method="post" class="card card-body" style="max-width: 32rem">
    <input type="hidden" asp-for="DisplayName" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="NewPassword" class="form-label"></label>
        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" autofocus />
        <span asp-validation-for="NewPassword" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Reset password</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
