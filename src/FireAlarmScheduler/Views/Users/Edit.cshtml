@* Edit an account's email, display name, roles, and technician link. *@
@model UserFormModel
@{
    ViewData["Title"] = "Edit user";
}

<h1 class="h3">Edit user</h1>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card card-body" style="max-width: 48rem">
    <partial name="_Form" model="Model" />
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Save</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
