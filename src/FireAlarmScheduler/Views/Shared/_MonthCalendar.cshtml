@* Monday–Sunday month grid used by the Jobs calendar and the team lead and technician month views. Each day lists its
   jobs by lane, so a multi-day job is one joined bar across its days (tinted by status, tagged with the shown
   technicians' colored initials), then approved PTO (striped). On phones names collapse to dots. *@
@model MonthCalendarViewModel
<div class="table-responsive">
    <table class="table table-bordered month-calendar mb-0" aria-label="@Model.Title">
        <thead>
            <tr>
                @foreach (var day in Model.Weeks[0])
                {
                    <th scope="col"><span class="d-none d-md-inline">@day.Date.ToString("ddd")</span><span class="d-md-none">@day.Date.ToString("ddd")[0]</span></th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var week in Model.Weeks)
            {
                <tr>
                    @foreach (var day in week)
                    {
                        <td class="@(day.InMonth ? "" : "other-month") @(day.IsToday ? "today" : "")">
                            @if (day.DayUrl is not null)
                            {
                                <a class="day-number" href="@day.DayUrl" aria-label="@day.Date.ToString("dddd, MMMM d")">@day.Date.Day</a>
                            }
                            else
                            {
                                <span class="day-number">@day.Date.Day</span>
                            }
                            @foreach (var slot in day.Slots)
                            {
                                if (slot is null)
                                {
                                    <div class="calendar-entry calendar-gap" aria-hidden="true">&nbsp;</div>
                                    continue;
                                }
                                var entry = slot.Entry;
                                var joins = (slot.ContinuesBefore ? " continues-before" : "") + (slot.ContinuesAfter ? " continues-after" : "");
                                <a class="calendar-entry job-status-@entry.Job.Status@joins" href="@entry.Url"
                                   title="@entry.Job.Name · @entry.Job.DateRangeText (@entry.Job.DurationText) · @entry.Job.TimeRangeText · @entry.Job.TechnicianNamesText">
                                    @* Tags come first so a long job name is what gets cut off, not the technicians. *@
                                    @foreach (var tech in entry.Technicians)
                                    {
                                        <span class="tech-tag tech-color-@tech.ColorIndex" title="@tech.FullName">@tech.Initials</span>
                                    }
                                    @if (entry.Technicians.Count == 0)
                                    {
                                        <span class="calendar-dot" aria-hidden="true"></span>
                                    }
                                    <span class="calendar-entry-name">@entry.Job.Name</span>
                                </a>
                            }
                            @foreach (var pto in day.Pto)
                            {
                                <div class="calendar-entry pto-entry" title="@pto.TechnicianName · PTO · @pto.HoursText">
                                    @if (pto.Tag is not null)
                                    {
                                        <span class="tech-tag tech-color-@pto.Tag.ColorIndex">@pto.Tag.Initials</span>
                                    }
                                    <span class="calendar-entry-name">PTO@(pto.HoursText == "All day" ? "" : $" · {pto.HoursText}")</span>
                                    <span class="calendar-dot pto-dot" aria-hidden="true"></span>
                                </div>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>
