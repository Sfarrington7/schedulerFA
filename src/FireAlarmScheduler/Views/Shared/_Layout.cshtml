@* Site layout: navigation, the Team Lead / Technician view switch, status messages, and page body. *@
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var isTechnicianView = controller == "TechnicianView";
    string NavClass(string name) => controller == name ? "nav-link active" : "nav-link";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fire Alarm Scheduler</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark app-navbar mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">Fire Alarm Scheduler</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="@NavClass("Home")" asp-controller="Home" asp-action="Index">Dashboard</a></li>
                        <li class="nav-item"><a class="@NavClass("Schedule")" asp-controller="Schedule" asp-action="Index">Schedule</a></li>
                        <li class="nav-item"><a class="@NavClass("Jobs")" asp-controller="Jobs" asp-action="Index">Jobs</a></li>
                        <li class="nav-item"><a class="@NavClass("Technicians")" asp-controller="Technicians" asp-action="Index">Technicians</a></li>
                        <li class="nav-item"><a class="@NavClass("TechnicianView")" asp-controller="TechnicianView" asp-action="Index">Technician View</a></li>
                    </ul>
                    <div class="btn-group btn-group-sm my-2 my-lg-0" role="group" aria-label="Switch view">
                        <a class="btn @(isTechnicianView ? "btn-outline-light" : "btn-light")" asp-controller="Home" asp-action="Index">Team Lead View</a>
                        <a class="btn @(isTechnicianView ? "btn-light" : "btn-outline-light")" asp-controller="TechnicianView" asp-action="Index">Technician View</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <div class="alert alert-secondary py-1 small" role="note">
            Prototype for local testing. There is no login, so the view switch is not security. Do not enter real customer or employee data.
        </div>
        <main role="main" class="pb-3">
            <partial name="_StatusMessages" />
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
