@* Shared create/edit form for a job: recurring-job choice, details, buildings (create only), schedule, status, notes,
   and the technician picker, which flags technicians who would have a scheduling conflict. On create, picking a recurring job reloads the form with its details and building list. *@
@model JobFormModel
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="row g-3">
    @if (Model.IsNew)
    {
        <div class="col-12">
            <div class="recurring-picker p-3 rounded">
                <label asp-for="RecurringJobId" class="form-label fw-semibold"></label>
                <div class="input-group">
                    <select asp-for="RecurringJobId" class="form-select" data-load-url="@Url.Action("Create")"
                            onchange="location = this.dataset.loadUrl + (this.value ? '?recurringJobId=' + this.value : '')">
                        <option value="">New job</option>
                        @if (Model.AvailableRecurringJobs.Count > 0)
                        {
                            <optgroup label="Recurring jobs">
                                @foreach (var option in Model.AvailableRecurringJobs)
                                {
                                    <option value="@option.Id" selected="@(option.Id == Model.RecurringJobId)">@option.Name@(option.Detail.Length > 0 ? $" — {option.Detail}" : "")</option>
                                }
                            </optgroup>
                        }
                    </select>
                    <noscript><button type="submit" class="btn btn-outline-secondary" formaction="@Url.Action("Create")" formmethod="get">Load</button></noscript>
                </div>
                <span asp-validation-for="RecurringJobId" class="text-danger small"></span>
                @if (Model.RecurringJobId is null)
                {
                    <div class="form-check mt-2">
                        <input asp-for="SaveAsRecurring" class="form-check-input" />
                        <label asp-for="SaveAsRecurring" class="form-check-label"></label>
                        <div class="form-text mt-0">Keeps this job's name, customer, site, and address, and its building list, for next time.</div>
                    </div>
                }
                else
                {
                    <div class="form-text">Its details and building list are filled in below. The recurring job's buildings can't be renamed here, but you can add notes or remove one for this round. Buildings you add are also saved to the recurring job for next time.</div>
                }
            </div>
        </div>
    }
    else if (Model.LinkedRecurringJobName is not null)
    {
        <div class="col-12">
            <div class="form-text"><span class="badge text-bg-info">Recurring</span> Part of <strong>@Model.LinkedRecurringJobName</strong>. If this is the newest job in the series, your changes to its name, customer, site, and address are saved for next time.</div>
        </div>
    }
    else
    {
        <div class="col-12">
            <div class="form-check">
                <input asp-for="SaveAsRecurring" class="form-check-input" />
                <label asp-for="SaveAsRecurring" class="form-check-label"></label>
                <div class="form-text mt-0">Reuse this job's details and building list when the job comes around again.</div>
            </div>
        </div>
    }
    <div class="col-md-6">
        <label asp-for="Name" class="form-label">Job / project name</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="CustomerName" class="form-label"></label>
        <input asp-for="CustomerName" class="form-control" />
        <span asp-validation-for="CustomerName" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="SiteName" class="form-label"></label>
        <input asp-for="SiteName" class="form-control" placeholder="e.g. Central Plaza campus" />
        <span asp-validation-for="SiteName" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Address" class="form-label"></label>
        <input asp-for="Address" class="form-control" />
        <span asp-validation-for="Address" class="text-danger small"></span>
    </div>
    @if (Model.IsNew)
    {
        <div class="col-12">
            <fieldset id="building-rows">
                <legend class="form-label fs-6 mb-1">Buildings</legend>
                <div class="form-text mt-0 mb-2">List each building at this location. You can also add buildings later from the job page.</div>
                <span asp-validation-for="Buildings" class="text-danger small d-block"></span>
                @for (var i = 0; i < Model.Buildings.Count + 1; i++)
                {
                    var row = i < Model.Buildings.Count ? Model.Buildings[i] : new BuildingRowModel();
                    var fromSeries = Model.RecurringJobId is not null && row.RecurringBuildingId is not null;
                    <div class="row g-2 mb-2 building-row">
                        <div class="col-sm-4">
                            @if (fromSeries)
                            {
                                @* Names of the recurring job's buildings are fixed here; the server uses the saved name. *@
                                <input type="hidden" name="Buildings[@i].RecurringBuildingId" value="@row.RecurringBuildingId" />
                                <input name="Buildings[@i].Name" value="@row.Name" class="form-control" readonly
                                       title="Buildings from the recurring job can't be renamed here" aria-label="Building name (from recurring job)" />
                            }
                            else
                            {
                                <input name="Buildings[@i].Name" value="@row.Name" class="form-control" placeholder="Building name, e.g. Building A" aria-label="Building name" maxlength="100" />
                            }
                        </div>
                        <div class="col">
                            <input name="Buildings[@i].Notes" value="@row.Notes" class="form-control" placeholder="Notes (optional)" aria-label="Building notes" maxlength="2000" />
                        </div>
                        <div class="col-auto">
                            <button type="button" class="btn btn-outline-danger" data-remove-building aria-label="Remove building">&times;</button>
                        </div>
                    </div>
                }
                <button type="button" class="btn btn-sm btn-outline-secondary" id="add-building">+ Add building</button>
            </fieldset>
        </div>
    }
    <div class="col-6 col-md-3">
        <label asp-for="StartDate" class="form-label"></label>
        <input asp-for="StartDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
        <span asp-validation-for="StartDate" class="text-danger small"></span>
    </div>
    <div class="col-6 col-md-3">
        <label asp-for="EndDate" class="form-label"></label>
        <input asp-for="EndDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
        <span asp-validation-for="EndDate" class="text-danger small"></span>
    </div>
    <div class="col-6 col-md-3">
        <label asp-for="StartTime" class="form-label"></label>
        <input asp-for="StartTime" type="time" asp-format="{0:HH:mm}" class="form-control" />
        <span asp-validation-for="StartTime" class="text-danger small"></span>
    </div>
    <div class="col-6 col-md-3">
        <label asp-for="EndTime" class="form-label"></label>
        <input asp-for="EndTime" type="time" asp-format="{0:HH:mm}" class="form-control" />
        <span asp-validation-for="EndTime" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" class="form-select">
            @foreach (var status in Enum.GetValues<JobStatus>())
            {
                <option value="@status">@status.ToDisplayName()</option>
            }
        </select>
    </div>
    <div class="col-12">
        @* Technician picker: a dropdown of checkboxes, each marked Free or Conflict for the dates and hours above.
           wwwroot/js/technician-picker.js refreshes the marks when those change and lists conflicts for the chosen technicians. *@
        <fieldset class="technician-picker" data-availability-url="@Url.Action("TechnicianAvailability")" data-job-id="@Model.Id">
            <legend class="form-label fs-6 mb-1">Assigned technicians</legend>
            @if (Model.AvailableTechnicians.Count == 0)
            {
                <p class="text-body-secondary small mb-0">No technicians yet. <a asp-controller="Technicians" asp-action="Create">Add technicians</a> first, then assign them here.</p>
            }
            else
            {
                var selected = Model.AvailableTechnicians.Where(t => Model.AssignedTechnicianIds.Contains(t.Id)).ToList();
                <div class="dropdown">
                    <button class="form-select text-start" type="button" id="technician-picker-toggle"
                            data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                        <span data-picker-summary>@(selected.Count == 0 ? "Choose technicians" : string.Join(", ", selected.Select(t => t.FullName)))</span>
                    </button>
                    <div class="dropdown-menu technician-menu p-1" aria-labelledby="technician-picker-toggle">
                        <div class="small text-body-secondary px-2 py-1" data-picker-note>
                            @(Model.AvailabilityChecked ? "Availability for the dates and hours above." : "Enter valid dates and hours to check availability.")
                        </div>
                        @foreach (var tech in Model.AvailableTechnicians)
                        {
                            var status = !Model.AvailabilityChecked ? "unknown" : tech.IsFree ? "free" : "conflict";
                            <label class="dropdown-item technician-choice" data-status="@status" data-name="@tech.FullName">
                                <input class="form-check-input" type="checkbox" name="AssignedTechnicianIds" value="@tech.Id"
                                       checked="@Model.AssignedTechnicianIds.Contains(tech.Id)" />
                                <span class="technician-choice-body">
                                    <span class="technician-choice-name">@tech.FullName</span>
                                    <span class="badge technician-status" data-status-badge>@(status switch { "free" => "Free", "conflict" => "Conflict", _ => "Not checked" })</span>
                                    <span class="technician-conflicts" data-conflicts>
                                        @foreach (var conflict in tech.Conflicts)
                                        {
                                            <span class="d-block">@conflict</span>
                                        }
                                    </span>
                                </span>
                            </label>
                        }
                    </div>
                </div>
                <div class="alert alert-warning py-2 px-3 small mt-2 mb-0" role="status" data-picker-warning
                     hidden="@(!selected.Any(t => !t.IsFree && Model.AvailabilityChecked))">
                    <strong>Scheduling conflict.</strong> You can still save this job, but these technicians are already busy:
                    <ul class="mb-0 ps-3" data-picker-warning-list>
                        @foreach (var tech in selected.Where(t => !t.IsFree && Model.AvailabilityChecked))
                        {
                            <li><strong>@tech.FullName</strong>: @string.Join("; ", tech.Conflicts)</li>
                        }
                    </ul>
                </div>
                <noscript><style>.technician-menu { display: block; position: static; }</style></noscript>
            }
            <span asp-validation-for="AssignedTechnicianIds" class="text-danger small"></span>
        </fieldset>
    </div>
    <div class="col-12">
        <label asp-for="Notes" class="form-label"></label>
        <textarea asp-for="Notes" class="form-control" rows="4" placeholder="Access instructions, contacts, panel location…"></textarea>
        <span asp-validation-for="Notes" class="text-danger small"></span>
    </div>
</div>
