@* Edit a job's details, schedule, status, and assigned technicians (flagging any scheduling conflicts). *@
@model JobFormModel
@{
    ViewData["Title"] = "Edit job";
}

<h1 class="h3">Edit job</h1>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card card-body">
    <partial name="_Form" model="Model" />
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Save</button>
        <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/technician-picker.js" asp-append-version="true"></script>
}
