@* Team management list: every technician with edit and remove actions. *@
@model List<TechnicianListItemViewModel>
@{
    ViewData["Title"] = "Technicians";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Technicians</h1>
    <a class="btn btn-primary" asp-action="Create">Add technician</a>
</div>

@if (Model.Count == 0)
{
    <p class="text-body-secondary">No technicians yet. Add your team to start assigning jobs.</p>
}
else
{
    <div class="card">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th class="d-none d-sm-table-cell">Current/upcoming jobs</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tech in Model)
                {
                    <tr>
                        <td>@tech.FullName</td>
                        <td class="d-none d-sm-table-cell">@tech.UpcomingJobCount</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="TechnicianView" asp-action="Index" asp-route-technicianId="@tech.Id">Schedule</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@tech.Id">Edit</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@tech.Id">Remove</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
